{
  "name": "some-assembly-required-desktop",
  "productName": "Some Assembly Required",
  "description": "Some Assembly Required as a desktop app",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.cjs",
  "author": "NeonGrayX",
  "desktopName": "some-assembly-required.desktop",
  "repository": "github:NeonGrayX/Some-Assembly-Required",
  "license": "CC0-1.0",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "npm run bundle && electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run bundle && electron-builder --publish never",
    "dist:dir": "npm run bundle && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
