{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeonGrayX/Some-Assembly-Required/docs/build-file.schema.json",
  "title": "Some Assembly Required build file, version 1",
  "description": "The shape of a build file. The grid rules (buildable in order, rests on something, bins) are checked by the game. See 07-build-file-format.md.",
  "type": "object",
  "required": ["format", "version", "build", "manual"],
  "properties": {
    "format": {
      "const": "some-assembly-required/build"
    },
    "version": {
      "const": 1
    },
    "build": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "author": {
          "type": "string",
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "manual": {
      "type": "object",
      "required": ["pages"],
      "properties": {
        "cover": {
          "type": "object",
          "properties": {
            "view": {
              "$ref": "#/$defs/view"
            }
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    "svgs": {
      "description": "The pictures bricks print, by name: each the text of one SVG image. Leave the section out for the clean version of the build; its prints are then ignored.",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/svgName"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 32768,
        "pattern": "<svg[\\s>]"
      }
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "zoom": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["bricks"],
      "properties": {
        "bricks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/brick"
          }
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "note": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "brick": {
      "type": "object",
      "required": ["type", "colour", "x", "y", "z", "rot"],
      "properties": {
        "type": {
          "enum": [
            "1x1",
            "1x2",
            "1x3",
            "1x4",
            "1x6",
            "2x2",
            "2x3",
            "2x4",
            "plate1x1",
            "plate1x2",
            "plate1x3",
            "plate1x4",
            "plate1x6",
            "plate1x8",
            "plate2x2",
            "plate2x3",
            "plate2x4",
            "plate2x6",
            "plate2x8",
            "plate4x4",
            "plate8x8",
            "1x2x2",
            "tile1x1",
            "tile1x2",
            "tile1x3",
            "tile1x4",
            "tile1x6",
            "tile2x2",
            "tile2x4",
            "grille1x2",
            "roundtile1x1",
            "roundtile2x2",
            "roundplate1x1",
            "round1x1",
            "roundplate2x2",
            "round2x2",
            "roundcorner3x3",
            "arc3x3",
            "dish2x2",
            "cone1x1",
            "slope1x2",
            "slope2x2",
            "slope2x3",
            "cheese1x1",
            "curve1x2",
            "window1x2x2",
            "lattice1x2x2",
            "headlight1x1",
            "sidestuds1x2",
            "sidestuds1x4",
            "sidestuds1x2x2",
            "bracket1x1",
            "bracket1x2",
            "bracket2x4",
            "plant1x1",
            "flower2x2",
            "spire2x2"
          ]
        },
        "colour": {
          "enum": [
            "white",
            "light-grey",
            "dark-grey",
            "black",
            "red",
            "dark-red",
            "yellow",
            "orange",
            "blue",
            "dark-blue",
            "green",
            "brown",
            "tan",
            "teal",
            "pink",
            "purple",
            "light-blue",
            "lime",
            "gold",
            "dark-brown",
            "sand-green",
            "trans-clear",
            "trans-light-blue",
            "trans-blue",
            "trans-red",
            "trans-orange",
            "trans-black",
            "trans-green"
          ]
        },
        "x": {
          "description": "A whole number, or half way between two for a part with a centre hollow (dish2x2, cone1x1) sitting half a stud off the grid; x and z are then both half way.",
          "type": "number",
          "multipleOf": 0.5,
          "minimum": 0,
          "maximum": 15
        },
        "y": {
          "type": "integer",
          "minimum": 1,
          "maximum": 47
        },
        "z": {
          "description": "A whole number, or half way between two for a part with a centre hollow (dish2x2, cone1x1) sitting half a stud off the grid; x and z are then both half way.",
          "type": "number",
          "multipleOf": 0.5,
          "minimum": 0,
          "maximum": 15
        },
        "rot": {
          "enum": [0, 1, 2, 3]
        },
        "face": {
          "enum": ["+x", "-x", "+z", "-z"]
        },
        "prints": {
          "description": "Pictures on the brick's sides, each the name of one of the file's svgs. Sides are in the brick's own frame: top is where its studs are, front its +z, right its +x.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "top": {
              "$ref": "#/$defs/svgName"
            },
            "bottom": {
              "$ref": "#/$defs/svgName"
            },
            "front": {
              "$ref": "#/$defs/svgName"
            },
            "back": {
              "$ref": "#/$defs/svgName"
            },
            "left": {
              "$ref": "#/$defs/svgName"
            },
            "right": {
              "$ref": "#/$defs/svgName"
            }
          }
        }
      }
    },
    "svgName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    }
  }
}
