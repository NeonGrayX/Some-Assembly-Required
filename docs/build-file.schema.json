{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeonGrayX/Some-Assembly-Required/docs/build-file.schema.json",
  "title": "Some Assembly Required build file, version 3",
  "description": "The shape of a build file. The grid rules (buildable in order, rests on something, bins) are checked by the game. See 07-build-file-format.md.",
  "type": "object",
  "required": ["format", "version", "build", "manual"],
  "properties": {
    "format": {
      "const": "some-assembly-required/build"
    },
    "version": {
      "description": "3, or 2 for a build with no turned parts and its sideways parts where side studs of upright parts hold them. Version 1 files are still read: their sideways parts are moved onto their side studs.",
      "enum": [1, 2, 3]
    },
    "build": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "author": {
          "type": "string",
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "manual": {
      "type": "object",
      "required": ["pages"],
      "properties": {
        "cover": {
          "type": "object",
          "properties": {
            "view": {
              "$ref": "#/$defs/view"
            }
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/page"
          }
        }
      }
    },
    "svgs": {
      "description": "The pictures bricks print, by name: each the text of one SVG image. Leave the section out for the clean version of the build; its prints are then ignored.",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/svgName"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 32768,
        "pattern": "<svg[\\s>]"
      }
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "zoom": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["bricks"],
      "properties": {
        "bricks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/brick"
          }
        },
        "view": {
          "$ref": "#/$defs/view"
        },
        "note": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "brick": {
      "type": "object",
      "required": ["type", "colour", "x", "y", "z", "rot"],
      "properties": {
        "type": {
          "enum": [
            "1x1",
            "1x2",
            "1x3",
            "1x4",
            "1x6",
            "2x2",
            "2x3",
            "2x4",
            "1x8",
            "1x10",
            "1x12",
            "1x16",
            "2x6",
            "2x8",
            "2x10",
            "4x6",
            "plate1x1",
            "plate1x2",
            "plate1x3",
            "plate1x4",
            "plate1x6",
            "plate1x8",
            "plate2x2",
            "plate2x3",
            "plate2x4",
            "plate2x6",
            "plate2x8",
            "plate4x4",
            "plate8x8",
            "plate1x10",
            "plate1x12",
            "plate2x10",
            "plate2x12",
            "plate2x16",
            "plate3x3",
            "plate4x6",
            "plate4x8",
            "plate4x10",
            "plate4x12",
            "plate6x6",
            "plate6x8",
            "plate6x10",
            "plate6x12",
            "plate8x16",
            "1x2x2",
            "tile1x1",
            "tile1x2",
            "tile1x3",
            "tile1x4",
            "tile1x6",
            "tile2x2",
            "tile2x4",
            "grille1x2",
            "roundtile1x1",
            "roundtile2x2",
            "roundplate1x1",
            "round1x1",
            "roundplate2x2",
            "round2x2",
            "roundcorner3x3",
            "arc3x3",
            "dish2x2",
            "cone1x1",
            "slope1x2",
            "slope2x2",
            "slope2x3",
            "cheese1x1",
            "curve1x2",
            "window1x2x2",
            "lattice1x2x2",
            "headlight1x1",
            "sidestuds1x2",
            "sidestuds1x4",
            "sidestuds1x2x2",
            "bracket1x1",
            "bracket1x2",
            "bracket2x4",
            "plant1x1",
            "leaf2x2",
            "spire2x2",
            "1x2x3",
            "1x4x3",
            "2x2x3",
            "1x1x5",
            "1x2x5",
            "tile1x8",
            "tile2x3",
            "tile2x6",
            "tile4x4",
            "tile6x6",
            "slope1x3",
            "slope4x2",
            "slope3x3",
            "slope4x3",
            "cheese1x2",
            "curve2x2",
            "curve1x3",
            "sidestuds1x1",
            "sidestuds2sides1x1",
            "sidestuds4sides1x1",
            "bracket1x2x2",
            "jumper1x2",
            "jumper2x2",
            "invbracket1x2",
            "invbracket1x2x2",
            "bracket1x2to1x4",
            "roundtile2x2hole"
          ]
        },
        "colour": {
          "enum": [
            "white",
            "light-grey",
            "dark-grey",
            "black",
            "red",
            "dark-red",
            "yellow",
            "orange",
            "blue",
            "dark-blue",
            "green",
            "brown",
            "tan",
            "teal",
            "pink",
            "purple",
            "light-blue",
            "lime",
            "gold",
            "dark-brown",
            "sand-green",
            "trans-clear",
            "trans-light-blue",
            "trans-blue",
            "trans-red",
            "trans-orange",
            "trans-black",
            "trans-green",
            "light-orange",
            "dark-orange",
            "light-yellow",
            "coral",
            "bright-pink",
            "magenta",
            "lavender",
            "medium-lavender",
            "medium-azure",
            "dark-azure",
            "medium-blue",
            "sand-blue",
            "dark-turquoise",
            "dark-green",
            "olive-green",
            "yellowish-green",
            "dark-tan",
            "light-nougat",
            "nougat",
            "medium-nougat",
            "pearl-gold",
            "flat-silver",
            "trans-yellow",
            "trans-pink",
            "trans-purple",
            "trans-neon-green",
            "trans-neon-orange"
          ]
        },
        "x": {
          "description": "A whole number, or half way between two for a part with a centre hollow (dish2x2, roundtile2x2, cone1x1, round1x1, roundplate1x1, roundtile1x1) sitting half a stud off the grid; x and z are then both half way. For a sideways part, the one along its face may also be 0.2 either side of a whole number: half a plate back into a headlight brick's recess, or out on a bracket's flange. In version 3 a sideways or turned part may be anywhere in twentieths of a stud.",
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "y": {
          "description": "A whole number. A sideways part sits where its side studs put it, which may be half way between two (a stud is 2.5 plates). In version 3 a sideways or turned part may be anywhere in eighths of a plate.",
          "type": "number",
          "multipleOf": 0.125,
          "minimum": 0.5,
          "maximum": 47
        },
        "z": {
          "description": "A whole number, or half way between two for a part with a centre hollow (dish2x2, roundtile2x2, cone1x1, round1x1, roundplate1x1, roundtile1x1) sitting half a stud off the grid; x and z are then both half way. For a sideways part, the one along its face may also be 0.2 either side of a whole number: half a plate back into a headlight brick's recess, or out on a bracket's flange. In version 3 a sideways or turned part may be anywhere in twentieths of a stud.",
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "rot": {
          "enum": [0, 1, 2, 3]
        },
        "face": {
          "enum": ["+x", "-x", "+z", "-z"]
        },
        "orient": {
          "description": "Version 3. Turned any of 24 ways: the way the part's top points, then the way its own +x points. x, y and z are then the turned part's corner with the lowest x, y and z, and rot is 0.",
          "enum": [
            "+y+x",
            "+y-z",
            "+y-x",
            "+y+z",
            "+x+y",
            "+x+z",
            "+x-y",
            "+x-z",
            "-x+y",
            "-x-z",
            "-x-y",
            "-x+z",
            "+z+y",
            "+z-x",
            "+z-y",
            "+z+x",
            "-z+y",
            "-z+x",
            "-z-y",
            "-z-x",
            "-y+x",
            "-y+z",
            "-y-x",
            "-y-z"
          ]
        },
        "prints": {
          "description": "Pictures on the brick's sides, each the name of one of the file's svgs. Sides are in the brick's own frame: top is where its studs are, front its +z, right its +x.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "top": {
              "$ref": "#/$defs/svgName"
            },
            "bottom": {
              "$ref": "#/$defs/svgName"
            },
            "front": {
              "$ref": "#/$defs/svgName"
            },
            "back": {
              "$ref": "#/$defs/svgName"
            },
            "left": {
              "$ref": "#/$defs/svgName"
            },
            "right": {
              "$ref": "#/$defs/svgName"
            }
          }
        }
      }
    },
    "svgName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    }
  }
}
