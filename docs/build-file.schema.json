{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeonGrayX/Some-Assembly-Required/docs/build-file.schema.json",
  "title": "Some Assembly Required build file, version 1",
  "description": "The shape of a build file. The grid rules (buildable in order, rests on something, bins) are checked by the game. See 07-build-file-format.md.",
  "type": "object",
  "required": ["format", "version", "build", "manual"],
  "properties": {
    "format": { "const": "some-assembly-required/build" },
    "version": { "const": 1 },
    "build": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 20 },
        "author": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 200 }
      }
    },
    "manual": {
      "type": "object",
      "required": ["pages"],
      "properties": {
        "cover": {
          "type": "object",
          "properties": { "view": { "$ref": "#/$defs/view" } }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/page" }
        }
      }
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "properties": {
        "turn": { "type": "integer", "minimum": 0, "maximum": 3 },
        "zoom": { "type": "number", "minimum": 0.5, "maximum": 2 }
      }
    },
    "page": {
      "type": "object",
      "required": ["bricks"],
      "properties": {
        "bricks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/brick" }
        },
        "view": { "$ref": "#/$defs/view" },
        "note": { "type": "string", "maxLength": 60 }
      }
    },
    "brick": {
      "type": "object",
      "required": ["type", "colour", "x", "y", "z", "rot"],
      "properties": {
        "type": {
          "enum": ["1x1", "1x2", "1x4", "2x2", "2x3", "2x4", "plate1x2", "plate2x2", "plate2x4"]
        },
        "colour": {
          "enum": [
            "white",
            "light-grey",
            "dark-grey",
            "black",
            "red",
            "dark-red",
            "yellow",
            "orange",
            "blue",
            "dark-blue",
            "green"
          ]
        },
        "x": { "type": "integer", "minimum": 0, "maximum": 15 },
        "y": { "type": "integer", "minimum": 1, "maximum": 47 },
        "z": { "type": "integer", "minimum": 0, "maximum": 15 },
        "rot": { "enum": [0, 1, 2, 3] }
      }
    }
  }
}
